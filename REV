<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mon Site - En Construction</title>
    <style>
        /* Styles globaux */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }
        
        body {
            background-color: #f5f5f5;
            color: #333;
            line-height: 1.6;
            padding: 20px;
        }
        
        /* Titre rouge */
        .titre-rouge {
            color: red;
            text-align: center;
            padding: 20px;
            font-size: 2.5em;
            margin-bottom: 30px;
            background-color: white;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        
        /* Menu de navigation */
        .nav-menu {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 10px;
            margin: 30px 0;
            list-style: none;
            padding: 20px;
            background-color: white;
            border-radius: 10px;
        }
        
        .nav-menu a {
            padding: 12px 25px;
            background-color: #4a6fa5;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            font-weight: bold;
            transition: all 0.3s ease;
        }
        
        .nav-menu a:hover {
            background-color: #2c3e50;
            transform: translateY(-3px);
        }
        
        /* Page de construction */
        .page-construction {
            max-width: 600px;
            margin: 50px auto;
            padding: 40px;
            background-color: white;
            border-radius: 15px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }
        
        .page-construction h1 {
            color: #e67e22;
            margin-bottom: 20px;
            font-size: 2em;
        }
        
        .page-construction p {
            margin-bottom: 30px;
            font-size: 1.1em;
            color: #555;
        }
        
        .btn-retour {
            display: inline-block;
            padding: 15px 30px;
            background-color: #3498db;
            color: white;
            text-decoration: none;
            border-radius: 50px;
            font-weight: bold;
            transition: all 0.3s ease;
        }
        
        .btn-retour:hover {
            background-color: #2980b9;
            transform: scale(1.05);
        }
        
        /* Indicateur pour liens en construction */
        .en-construction {
            position: relative;
            display: inline-block;
        }
        
        .en-construction::after {
            content: " 🚧";
            font-size: 0.8em;
            color: #e67e22;
        }
        
        .en-construction::before {
            content: "";
            position: absolute;
            top: -5px;
            right: -5px;
            width: 12px;
            height: 12px;
            background-color: #e67e22;
            border-radius: 50%;
            animation: pulse 1.5s infinite;
        }
        
        @keyframes pulse {
            0% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.3); opacity: 0.7; }
            100% { transform: scale(1); opacity: 1; }
        }
        
        /* Contenu principal */
        .contenu-principal {
            max-width: 800px;
            margin: 0 auto;
            padding: 30px;
            background-color: white;
            border-radius: 10px;
            margin-bottom: 30px;
        }
        
        .contenu-principal h2 {
            color: #2c3e50;
            margin-bottom: 20px;
            border-bottom: 2px solid #3498db;
            padding-bottom: 10px;
        }
        
        .contenu-principal p {
            margin-bottom: 15px;
        }
        
        /* Pied de page */
        footer {
            text-align: center;
            padding: 20px;
            margin-top: 40px;
            color: #7f8c8d;
            font-size: 0.9em;
            border-top: 1px solid #ddd;
        }
        
        /* Responsive */
        @media (max-width: 768px) {
            .nav-menu {
                flex-direction: column;
                align-items: center;
            }
            
            .nav-menu a {
                width: 80%;
                text-align: center;
            }
            
            .titre-rouge {
                font-size: 2em;
                padding: 15px;
            }
        }
    </style>
</head>
<body>
    <!-- Titre rouge comme demandé -->
    <h1 class="titre-rouge">Voici mon travail</h1>
    
    <!-- Menu de navigation -->
    <nav>
        <ul class="nav-menu">
            <li><a href="#accueil">Accueil</a></li>
            <li><a href="construction.html" class="en-construction">Services</a></li>
            <li><a href="construction.html" class="en-construction">Portfolio</a></li>
            <li><a href="#contact">Contact</a></li>
            <li><a href="construction.html" class="en-construction">Blog</a></li>
        </ul>
    </nav>
    
    <!-- Contenu principal -->
    <main class="contenu-principal">
        <h2>Bienvenue sur mon site</h2>
        
        <p>Ce site démontre la gestion des liens en construction. Certains liens sont fonctionnels, d'autres mènent vers une page "en construction".</p>
        
        <h3>Liens de démonstration :</h3>
        <ul style="padding-left: 20px; margin: 20px 0;">
            <li><a href="#accueil">Lien fonctionnel (ancre)</a></li>
            <li><a href="construction.html" class="en-construction">Lien en construction</a></li>
            <li><a href="#contact">Autre lien fonctionnel</a></li>
            <li><a href="construction.html" class="en-construction">Page future</a></li>
        </ul>
        
        <div id="accueil">
            <h3>Section Accueil</h3>
            <p>Cette section est accessible via le lien "Accueil" dans le menu.</p>
        </div>
        
        <div id="contact" style="margin-top: 40px;">
            <h3>Section Contact</h3>
            <p>Cette section est accessible via le lien "Contact" dans le menu.</p>
            <p>Email: contact@monsite.fr</p>
        </div>
    </main>
    
    <!-- Code JavaScript pour gérer les liens -->
    <script>
        // Cette fonction s'exécute quand la page est chargée
        document.addEventListener('DOMContentLoaded', function() {
            // Récupère tous les liens de la page
            const tousLesLiens = document.querySelectorAll('a');
            
            // Pour chaque lien
            tousLesLiens.forEach(lien => {
                const href = lien.getAttribute('href');
                
                // Si le lien pointe vers "construction.html"
                if (href === 'construction.html') {
                    // On ajoute un événement au clic
                    lien.addEventListener('click', function(e) {
                        // Empêche le comportement par défaut
                        e.preventDefault();
                        
                        // Affiche la page de construction
                        afficherPageConstruction();
                    });
                }
            });
            
            // Fonction pour afficher la page de construction
            function afficherPageConstruction() {
                // Crée la page de construction
                const pageConstruction = document.createElement('div');
                pageConstruction.className = 'page-construction';
                pageConstruction.innerHTML = `
                    <h1>🚧 Page en Construction 🚧</h1>
                    <p>Cette page n'est pas encore disponible. Nous travaillons dessus et elle sera bientôt en ligne.</p>
                    <p>Merci de votre patience !</p>
                    <a href="#" class="btn-retour" id="btn-retour-accueil">Retour à l'accueil</a>
                `;
                
                // Remplace tout le contenu de la page
                document.body.innerHTML = '';
                document.body.appendChild(pageConstruction);
                
                // Ajoute l'événement pour le bouton retour
                document.getElementById('btn-retour-accueil').addEventListener('click', function(e) {
                    e.preventDefault();
                    location.reload(); // Recharge la page pour revenir à l'accueil
                });
            }
            
            console.log('Gestionnaire de liens initialisé avec succès!');
        });
    </script>
    
    <!-- Pied de page -->
    
</body>
